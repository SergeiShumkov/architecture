@startuml

' Подключение встроенной библиотеки вместо URL
!include <C4/C4_Context>

TITLE Диаграмма контекста: Онлайн-магазин

Person(customer, "Покупатель", "Клиент, оформляющий заказы на сайте")
System(e_commerce, "Система интернет-магазина", "Позволяет просматривать товары и делать покупки")
System_Ext(payment_gateway, "Платежный шлюз", "Внешний сервис обработки онлайн-платежей")

Rel(customer, e_commerce, "Просматривает товары, оформляет заказы", "HTTPS")
Rel(e_commerce, payment_gateway, "Отправляет запрос на проведение оплаты", "JSON/HTTPS")
Rel_Back(customer, payment_gateway, "Перенаправляет на страницу авторизации банка")

@enduml